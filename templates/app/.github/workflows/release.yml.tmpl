name: Release

on:
  push:
    tags: ["v*"]
  release:
    types: [published]

permissions:
  contents: write

concurrency:
  group: release-${{ github.ref_name }}
  cancel-in-progress: false

env:
  CARGO_TERM_COLOR: always

jobs:
  linux:
    name: Linux build
    runs-on: ubuntu-22.04
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
      - name: Test
        run: cargo test --release
      - name: Build
        run: cargo build --release
      - name: Package
        run: |
          name="__SLUG__-${GITHUB_REF_NAME}-linux-x86_64"
          mkdir -p "$name/packaging"
          cp target/release/__SLUG__ install.sh README.md LICENSE "$name/"
          cp packaging/__SLUG__.desktop packaging/__SLUG__.svg "$name/packaging/"
          tar -czf "$name.tar.gz" "$name"
          sha256sum "$name.tar.gz" > "$name.tar.gz.sha256"
      - uses: actions/upload-artifact@v4
        with:
          name: linux
          path: __SLUG__-*.tar.gz*

  windows:
    name: Windows build
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
      - name: Build
        run: cargo build --release
      - name: Package
        shell: pwsh
        run: |
          $name = "__SLUG__-$env:GITHUB_REF_NAME-windows-x86_64"
          New-Item -ItemType Directory -Path $name | Out-Null
          Copy-Item target/release/__SLUG__.exe, README.md, LICENSE -Destination $name
          Compress-Archive -Path $name -DestinationPath "$name.zip"
          $hash = (Get-FileHash -Algorithm SHA256 "$name.zip").Hash.ToLower()
          "$hash  $name.zip" | Out-File -Encoding ascii -NoNewline "$name.zip.sha256"
      - uses: actions/upload-artifact@v4
        with:
          name: windows
          path: __SLUG__-*.zip*

  macos:
    name: macOS build (universal)
    runs-on: macos-15
    env:
      MACOSX_DEPLOYMENT_TARGET: "11.0"
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
        with:
          targets: aarch64-apple-darwin, x86_64-apple-darwin
      - uses: Swatinem/rust-cache@v2
      - name: Test
        run: cargo test --release
      - name: Build, sign and zip the app
        run: packaging/macos/bundle.sh --out dist
      - name: Install it the way a user would
        env:
          NCF_INSTALL_SOURCE: file://${{ github.workspace }}/dist
          NCF_INSTALL_APP_DIR: ${{ runner.temp }}/apps
          NCF_INSTALL_NO_OPEN: "1"
        run: |
          /bin/bash install-macos.sh
          codesign --verify --deep --strict "$NCF_INSTALL_APP_DIR/__NAME__.app"
          "$NCF_INSTALL_APP_DIR/__NAME__.app/Contents/MacOS/__SLUG__" --version
          /bin/bash install-macos.sh --uninstall
      - name: Package
        run: |
          cd dist
          name="__SLUG__-${GITHUB_REF_NAME}-macos-universal.zip"
          cp __SLUG__-macos.zip "$name"
          shasum -a 256 "$name" > "$name.sha256"
          cp ../install-macos.sh .
      - uses: actions/upload-artifact@v4
        with:
          name: macos
          path: |
            dist/__SLUG__-*.zip
            dist/__SLUG__-*.zip.sha256
            dist/install-macos.sh

  publish:
    name: GitHub Release
    needs: [linux, windows, macos]
    runs-on: ubuntu-latest
    steps:
      - uses: actions/download-artifact@v4
        with:
          merge-multiple: true
      - uses: softprops/action-gh-release@v2
        with:
          tag_name: ${{ github.ref_name }}
          files: |
            __SLUG__-*.tar.gz
            __SLUG__-*.zip
            __SLUG__-*.zip.sha256
            __SLUG__-*.tar.gz.sha256
            install-macos.sh
