#[cfg(test)]
mod tests;

use ncf::prelude::*;

pub const MARK: AppMark = AppMark {
    name: "__NAME__",
    parts: &[slab((0.27, 0.83), (0.49, 0.17)), line((0.585, 0.83), (0.805, 0.17))],
};

pub const INFO: AppInfo = AppInfo {
    name: "__NAME__",
    id: "__ID__",
    version: env!("CARGO_PKG_VERSION"),
    tagline: "__TAGLINE__",
    repo: "__REPO__",
    mark: MARK,
};

fn main() -> ncf::eframe::Result<()> {
    let args: Vec<String> = std::env::args().collect();
    let out = |flag: &str, default: &str| args.iter().position(|a| a == flag).map(|i| args.get(i + 1).cloned().unwrap_or_else(|| default.to_string()));
    if let Some(path) = out("--emit-icon", "__SLUG__.svg") {
        std::fs::write(&path, MARK.svg()).map_err(|e| eprintln!("{path}: {e}")).ok();
        return Ok(());
    }
    if let Some(path) = out("--emit-ico", "__SLUG__.ico") {
        std::fs::write(&path, MARK.ico()).map_err(|e| eprintln!("{path}: {e}")).ok();
        return Ok(());
    }
    if let Some(path) = out("--emit-icns", "__SLUG__.icns") {
        std::fs::write(&path, MARK.icns()).map_err(|e| eprintln!("{path}: {e}")).ok();
        return Ok(());
    }
    if let Some(path) = out("--emit-info-plist", "Info.plist") {
        std::fs::write(&path, ncf::bundle::info_plist(&INFO, "__SLUG__", "__NAME__")).map_err(|e| eprintln!("{path}: {e}")).ok();
        return Ok(());
    }
    if args.iter().any(|a| a == "--version" || a == "-V") {
        println!("__SLUG__ {}", INFO.version);
        return Ok(());
    }
    ncf::app::run(INFO, |_ctx, shell| app::App::load(shell))
}
